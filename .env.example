# Volimox — Environment Variables
# Copy this to .env.local and fill in your values

# Next.js
NEXT_PUBLIC_SITE_URL=http://localhost:3002

# --- Proton live booking bridge ---
# Server-side only. Do not expose these through NEXT_PUBLIC_* variables.
PROTON_API_BASE_URL=https://www.protonlimo.com
PROTON_API_KEY=your-proton-web-demo-shared-secret

# --- Gemini Live voice session ---
GEMINI_API_KEY=your-gemini-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# Optional capacity fallback. Defaults to the Gemini 2.5 native-audio model.
GEMINI_LIVE_FALLBACK_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# --- xAI Grok Live voice session ---
# Set VOICE_PROVIDER=xai to make Grok the primary browser voice provider.
VOICE_PROVIDER=xai
XAI_API_KEY=your-xai-api-key
XAI_VOICE_MODEL=grok-voice-think-fast-2.0
XAI_VOICE_NAME=carina
XAI_VOICE_SPEED=1.2

# --- Example Limo Proton-parity backend ---
# Development defaults to simulate. Production defaults to disabled/fail-closed.
EXAMPLE_LIMO_PROVIDER_MODE=simulate
# Explicit local-test opt-in to reuse the owner's existing Proton Google/Stripe/Twilio credentials.
# With provider mode=live, a successful checkout tool call can send a real SMS and create a real Stripe Checkout Session.
EXAMPLE_LIMO_USE_PROTON_CREDENTIALS=false
EXAMPLE_LIMO_GOOGLE_MAPS_API_KEY=your-example-limo-google-routes-key
EXAMPLE_LIMO_QUOTE_HMAC_SECRET=replace-with-a-32-byte-example-limo-secret
EXAMPLE_LIMO_STRIPE_SECRET_KEY=
EXAMPLE_LIMO_STRIPE_WEBHOOK_SECRET=
EXAMPLE_LIMO_TWILIO_ACCOUNT_SID=
EXAMPLE_LIMO_TWILIO_AUTH_TOKEN=
EXAMPLE_LIMO_TWILIO_MESSAGING_SERVICE_SID=
EXAMPLE_LIMO_TWILIO_PHONE_NUMBER=
EXAMPLE_LIMO_OPS_EMAIL=

# --- Volimox global demonstration bridge ---
# Google Routes must be enabled for worldwide distance and duration lookups.
GOOGLE_MAPS_API_KEY=your-server-side-google-maps-key
VOLIMOX_DEMO_LINK_SECRET=replace-with-a-32-byte-random-secret
VOLIMOX_DEMO_BASE_RATE=36
VOLIMOX_DEMO_PER_MILE_RATE=3.25

# --- Email (Gmail SMTP via App Password) ---
# Your Gmail address
SMTP_USER=your.email@gmail.com
# Gmail App Password (not your regular password)
# Generate one at: https://myaccount.google.com/apppasswords
SMTP_PASS=your-16-char-app-password

# Alternative SMTP names used by the production environment
EMAIL_USER=
EMAIL_PASS=
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587

# Where to send lead notifications (defaults to SMTP_USER if not set)
NOTIFICATION_EMAIL=you@volimox.ai

# Dedicated Volimox Firebase project ID guardrail
VOLIMOX_FIREBASE_PROJECT_ID=volimox-platform
VOLIMOX_DEMO_TENANT_ID=volimox-demo
# HMAC secret for non-Limo demo voice sessions. Required in production.
MOX_DEMO_VOICE_HMAC_SECRET=replace-with-a-32-byte-random-secret

# Rate-limit key HMAC secret (falls back to VOLIMOX_DEMO_LINK_SECRET if unset)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VOLIMOX_RATE_LIMIT_SECRET=

# Retell webhook signature verification secret
RETELL_WEBHOOK_SECRET=

# Leave blank to use the Firebase project's default Firestore database
VOLIMOX_FIRESTORE_DATABASE_ID=
RETELL_DEMO_VOICE_AGENT_ID=
RETELL_DEMO_FLOW_ID=
VOLIMOX_DEMO_PUBLIC_URL=https://volimox.com

# Optional dedicated Volimox sender. When set, demo calls and SMS use this number instead of Proton's sender.
VOLIMOX_DEMO_PHONE_NUMBER=

# --- Local development launcher ---
# npm run dev:local overrides these in its child process and disables providers.
# No credential values are needed for the local Example Limo walkthrough.
VOLIMOX_LOCAL_DEMO=false
NEXT_PUBLIC_VOLIMOX_LOCAL_DEMO=false
NEXT_DIST_DIR=.next

# --- Volimox persistence ---
# One-line service-account JSON or base64 JSON for volimox-platform only.
# Never copy the Proton Firebase service account into this application.
FIREBASE_SERVICE_ACCOUNT_KEY=
# Optional dedicated test emulator; disabled by dev:local.
FIRESTORE_EMULATOR_HOST=

# --- Browser voice session integrity and limits ---
VOICE_DEMO_SESSION_SECRET=replace-with-a-32-byte-random-secret
VOICE_DEMO_MAX_SESSION_MINUTES=10
VOICE_DEMO_MAX_SESSIONS_PER_IP_PER_HOUR=3
# Optional Gemini key alias accepted by the browser voice route.
GEMINI_VOICE_API_KEY=

# --- Retell and shared demo SMS providers ---
RETELL_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_PHONE_NUMBER=
TWILIO_DEMO_PHONE_NUMBER=

# --- Optional shared provider aliases ---
# Example Limo reads these only with EXAMPLE_LIMO_USE_PROTON_CREDENTIALS=true.
# Other demo routes may read the Google aliases independently.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
